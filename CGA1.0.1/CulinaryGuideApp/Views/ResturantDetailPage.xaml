<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CulinaryGuideApp.Views.RestaurantDetailPage"
             Title="{Binding Name}"
             BackgroundColor="#f4f4f4">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            <Label Text="{Binding Name}" FontSize="28" FontAttributes="Bold" TextColor="#333" HorizontalOptions="Center" Margin="0,0,0,15" />
            <BoxView HeightRequest="1" BackgroundColor="#ddd" Margin="0,0,0,15" />
            <Label Text="{Binding Description}" FontSize="18" TextColor="#555" LineBreakMode="WordWrap" />

            <Label Text="照片" FontSize="20" FontAttributes="Bold" TextColor="#333" Margin="0,15,0,10" />
            <ScrollView Orientation="Horizontal">
                <HorizontalStackLayout Spacing="10">
                    <CollectionView x:Name="ImageCollection" HeightRequest="150" ItemsLayout="HorizontalList">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Image Source="{Binding}" HeightRequest="150" WidthRequest="200" Aspect="AspectFill">
                                    <Image.Clip>
                                        <RoundRectangleGeometry CornerRadius="8" Rect="0,0,200,150" />
                                    </Image.Clip>
                                </Image>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </HorizontalStackLayout>
            </ScrollView>

            <Label Text="评论" FontSize="20" FontAttributes="Bold" TextColor="#333" Margin="0,15,0,10" />
            <CollectionView x:Name="CommentList">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="10" BackgroundColor="White" Stroke="#eee" StrokeThickness="1" StrokeShape="RoundRectangle 8" Margin="0,5">
                            <VerticalStackLayout Spacing="5">
                                <Label Text="{Binding UserName}" FontAttributes="Bold" TextColor="#333" />
                                <Label Text="{Binding Text}" FontSize="16" TextColor="#555" />
                                <Label Text="{Binding Date, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" FontSize="12" TextColor="#999" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Border Padding="10,0,10,0" BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 8" Margin="0,15,0,0">
                <Entry x:Name="CommentEntry"
                       Placeholder="添加评论..."
                       TextColor="#333"
                       PlaceholderColor="#aaa"
                       FontSize="16"
                       HeightRequest="45"
                       Visual="Default" />
            </Border>
            <Button Text="提交评论"
                    FontSize="16"
                    TextColor="White"
                    BackgroundColor="#512BD4"
                    HeightRequest="45"
                    CornerRadius="8"
                    Clicked="OnSubmitComment"
                    Margin="0,10,0,0" />
            <Button Text="添加照片"
                    FontSize="16"
                    TextColor="#512BD4"
                    BackgroundColor="Transparent"
                    BorderColor="#512BD4"
                    BorderWidth="1"
                    HeightRequest="45"
                    CornerRadius="8"
                    Clicked="OnAddPhoto"
                    Margin="0,10,0,0" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>