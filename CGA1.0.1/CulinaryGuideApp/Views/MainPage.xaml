<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:CulinaryGuideApp.Models"
    x:Class="CulinaryGuideApp.Views.MainPage"
    Title="美食指南"
    BackgroundColor="#f4f4f4">
    <ScrollView>
        <VerticalStackLayout Padding="15" Spacing="15">
            <Label Text="探索美食" FontSize="28" FontAttributes="Bold" TextColor="#333" Margin="0,0,0,15" />
            <CollectionView x:Name="RestaurantList"
                            ItemsSource="{Binding Restaurants}"
                            SelectionMode="Single"
                            SelectionChanged="RestaurantList_SelectionChanged">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Restaurant">
                        <Border Stroke="#ddd"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 12"
                                Padding="15"
                                Margin="0,10"
                                BackgroundColor="White">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="20" TextColor="#333" />
                                <Label Text="{Binding Location}" FontSize="14" TextColor="#777" />
                                <Label Text="{Binding Description}" FontSize="16" TextColor="#555" LineBreakMode="TailTruncation" MaxLines="2" />

                                <ScrollView Orientation="Horizontal" Margin="0,10,0,0">
                                    <HorizontalStackLayout Spacing="10">
                                        <CollectionView ItemsSource="{Binding ImagePaths}"
                                                        ItemsLayout="HorizontalList"
                                                        HeightRequest="120">
                                            <CollectionView.ItemTemplate>
                                                <DataTemplate x:DataType="x:String">
                                                    <Image Source="{Binding .}" HeightRequest="120" WidthRequest="180" Aspect="AspectFill">
                                                        <Image.Clip>
                                                            <RoundRectangleGeometry CornerRadius="8" Rect="0,0,180,120" />
                                                        </Image.Clip>
                                                    </Image>
                                                </DataTemplate>
                                            </CollectionView.ItemTemplate>
                                        </CollectionView>
                                    </HorizontalStackLayout>
                                </ScrollView>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>